# ================================================================
# FinGuard AI — Environment Configuration
# ================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Backend Server Configuration ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PORT=8000

# --- Database Configuration ---
# Defaults to local SQLite WAL database: finguard.db
FINGUARD_DB_PATH=finguard.db

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=finguard_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI & External Intelligence APIs (Optional) ---
# If omitted, FinGuard AI runs its built-in deterministic RAG & safety tool engine
GEMINI_API_KEY=

# --- Frontend Client Configuration ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
